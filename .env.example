# Copy this file to .env for local Docker development and replace every sensitive value.
# Never commit the generated .env file.

PBM_SA_PASSWORD=ChangeMe_StrongSqlPassword_123!
PBM_JWT_KEY=ChangeMe_UseAtLeast32RandomCharacters_ForJWTSigning
PBM_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_StrongAdminPassword_123!

# Short-lived client_credentials token lifetime for ERP service accounts.
PBM_INTEGRATION_TOKEN_MINUTES=30

# Durable outbox tuning. Defaults are suitable for local development.
PBM_OUTBOX_POLL_SECONDS=5
PBM_OUTBOX_BATCH_SIZE=20
PBM_OUTBOX_LOCK_SECONDS=120
PBM_OUTBOX_MAX_ATTEMPTS=8
PBM_OUTBOX_BASE_DELAY_SECONDS=15
PBM_OUTBOX_MAX_DELAY_SECONDS=3600

# Optional outbound notification webhook. It remains disabled unless explicitly enabled.
PBM_NOTIFICATION_WEBHOOK_ENABLED=false
PBM_NOTIFICATION_WEBHOOK_URL=
PBM_NOTIFICATION_WEBHOOK_ALLOW_HTTP=false
PBM_NOTIFICATION_WEBHOOK_BEARER_TOKEN=
