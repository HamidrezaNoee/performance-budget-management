# PBM Personal Production environment
# Copy to .env.personal and replace every CHANGE_ME value before installation.
# Never commit .env.personal.
# If a secret contains $, wrap the entire value in single quotes so Docker Compose treats it literally.

PBM_SA_PASSWORD=CHANGE_ME_StrongSqlPassword_123!
PBM_JWT_KEY=CHANGE_ME_UseAtLeast64RandomCharactersForJwtSigning_0123456789abcdef
PBM_ADMIN_PASSWORD=CHANGE_ME_StrongAdminPassword_123!

PBM_ADMIN_USERNAME=admin
PBM_ADMIN_DISPLAY_NAME=مدیر سامانه
PBM_TENANT_CODE=PERSONAL
PBM_TENANT_NAME=PBM Personal
PBM_COMPANY_CODE=COMPANY-01
PBM_COMPANY_NAME=شرکت اصلی
PBM_COMPANY_INDUSTRY=General
PBM_LICENSE_KEY=PERSONAL-PBM-LICENSE
PBM_LICENSE_DAYS=3650
PBM_MAX_COMPANIES=5
PBM_MAX_USERS=100

PBM_WEB_PORT=3000
# 14330 avoids the common conflict with an existing local SQL Server on 1433.
PBM_SQL_PORT=14330
PBM_BACKUP_DIR=./.pbm/backups
PBM_JWT_ISSUER=PBM.Personal
PBM_JWT_AUDIENCE=PBM.Web
PBM_PROVISION_INITIAL_TENANT=true
